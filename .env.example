VITE_API_URL=
# localhost SSO 오버라이드. 기본 인증 앱 http://localhost:5174, 모드 auth-app
# VITE_AUTH_APP_URL=http://localhost:5174
# VITE_SSO_LOGIN_MODE=direct
# 로컬 Vite `/api` 프록시 대상 (SSO 패키지 상대경로용). 기본 api-dev
# VITE_DEV_API_PROXY_TARGET=https://api-dev.university.neordinary.com
# QA용 임시 로그인 화면의 권한별 계정 버튼. "라벨=이메일"을 쉼표로 구분 (비밀번호는 넣지 않음)
VITE_QA_ACCOUNTS=

# Firebase Analytics(GA4) 웹 앱 설정. 하나라도 비어 있으면 초기화하지 않고, 배포 빌드에서만 켜짐
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=
